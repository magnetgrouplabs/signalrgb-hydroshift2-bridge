// Link-time stand-in for SignalRGB's native "@SignalRGB/lcd" module.
//
// SignalRGB loads LianLi_HydroShift2_Bridge.js in two JavaScript engines. The device
// engine registers the real lcd module natively and never reaches this file (Qt checks
// native modules by the raw specifier before resolving files). The discovery engine has
// no lcd module, so its import of "@SignalRGB/lcd" resolves to this file, relative to
// the plugin. It exists only so that import links; nothing here is ever called.
export default {
	isShim: true,
	initialize: function () {},
	getFrame: function () { return null; },
	getImageBuffer: function () { return null; }
};
